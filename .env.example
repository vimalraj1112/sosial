# ---------------------------------------------------------------------------
# SOSIAL — environment example
# Copy to .env.local for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Canonical origin used for metadata, sitemap, OG URLs and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://sosial.solutions

# --- Enquiry delivery -------------------------------------------------------
# Delivery is attempted in this order: Resend -> webhook -> local file sink.
# With none configured, the API returns an honest 503 and the form tells the
# visitor to email directly. It never reports a fake success.

# Option 1 (recommended): Resend
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=sosial.solutions@gmail.com
ENQUIRY_FROM_EMAIL=SOSIAL <enquiries@sosial.solutions>

# Option 2: webhook, CRM or automation endpoint (receives a JSON POST)
ENQUIRY_WEBHOOK_URL=

# Option 3: local preview file sink (default: on). Writes JSON files to
# .data/enquiries. Set to "off" on serverless hosts where disk is ephemeral.
ENQUIRY_FILE_SINK=on
