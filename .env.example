# ---------------------------------------------------------------------------
# SOSIAL — environment example
# Copy to .env.local for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Canonical origin used for metadata, sitemap, OG URLs and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://sosial.solutions

# --- Enquiry delivery -------------------------------------------------------
# Delivery is attempted in this order: Resend -> Gmail/SMTP -> webhook -> file.
# With none configured, the API returns an honest 503 and the form tells the
# visitor to email directly. It never reports a fake success.

# Option 1 (quickest): Gmail SMTP. Use a Google app password, not the normal
# account password. Google shows app passwords with spaces; they are optional.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sosial.solutions@gmail.com
SMTP_PASS=

# Recipient and sender. For Gmail, use the same address for SMTP_USER and
# ENQUIRY_FROM_EMAIL. For Resend, ENQUIRY_FROM_EMAIL must be a verified sender.
ENQUIRY_TO_EMAIL=sosial.solutions@gmail.com
ENQUIRY_FROM_EMAIL=SOSIAL <sosial.solutions@gmail.com>

# Option 2: Resend
RESEND_API_KEY=

# Option 3: webhook, CRM or automation endpoint (receives a JSON POST)
ENQUIRY_WEBHOOK_URL=

# Option 4: local preview file sink. Writes JSON files to .data/enquiries.
# On in development by default, off in production unless explicitly set to "on".
# Set to "off" on serverless hosts where disk is ephemeral.
ENQUIRY_FILE_SINK=on
